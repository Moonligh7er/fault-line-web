    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0-rc.2",
    "react-leaflet-cluster": "^4.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@sentry/nextjs": "^8.47.0",
    "@types/leaflet": "^1.9.15",
