# ============================================================
# Fault Line Web — Environment Variables
# ============================================================
# NEVER commit real values. Copy to .env.local for local dev.
# Production values live in Vercel project settings.
# ============================================================

# --- Public app config ---
# Full origin, e.g. http://localhost:3000 locally. Required in production.
NEXT_PUBLIC_APP_ORIGIN=
NEXT_PUBLIC_SITE_NAME=

# --- Supabase (publishable key only — client-safe) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase Service Role (SERVER ONLY — never expose to client) ---
# Webhooks, cron, the internal API scope, and the database rate limiter.
# Normal reads/writes go through RLS with the anon key.
SUPABASE_SERVICE_ROLE_KEY=

# --- Upstash Redis (rate limiting; optional) ---
# Unset = rate limits are kept in the database (rate_limit_hit).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Sentry (error monitoring; optional) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Google Analytics (optional) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- CRON secret for scheduled tasks (at least 16 characters) ---
CRON_SECRET=

# --- Kokoro TTS (read-aloud; optional) ---
# Full URL of the TTS endpoint. Unset = read-aloud uses the browser's voice.
KOKORO_TTS_URL=

# --- Stripe city billing (SERVER ONLY; optional) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Resend webhook signing secret (SERVER ONLY; whsec_...) ---
RESEND_WEBHOOK_SECRET=
