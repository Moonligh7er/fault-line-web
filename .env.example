# ============================================================
# Fault Line Web — Environment Variables
# ============================================================
# NEVER commit real values. Copy to .env.local for local dev.
# Production values live in Vercel project settings.
# ============================================================

# --- Public app config ---
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Fault Line"

# --- Supabase (publishable key only — client-safe) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_key_here

# --- Supabase Service Role (SERVER ONLY — never expose to client) ---
# Used only by server routes that need elevated access.
# Normal reads/writes go through RLS with the anon key.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- Upstash Redis (rate limiting) ---
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token

# --- Sentry (error monitoring) ---
NEXT_PUBLIC_SENTRY_DSN=https://your_dsn@sentry.io/project_id
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=fault-line-web
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# --- Google Analytics ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- CRON secret for scheduled tasks ---
CRON_SECRET=generate_with_openssl_rand_base64_32

# --- Kokoro TTS (shared Modal-hosted server) ---
# Override only if running a private deployment.
KOKORO_TTS_URL=https://moons7onr--kokoro-tts-server-kokorotts-tts.modal.run
